@startuml use-cases-security
' Use case view for section 3.2.1: sign-in and matter security. "Platform user"
' stands for every role that signs in, so the diagram does not draw six lines to
' the one use case.
'
' Noto Sans for the reason given in business-view.puml.
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Noto Sans"
skinparam defaultFontSize 12
skinparam rectangleRoundCorner 0
left to right direction

actor "Platform\nuser" as user
actor "Security\nadministrator" as admin

rectangle "eDiscovery and Litigation Document Review Platform" {
  usecase "UC-16\nSign in" as uc16
  usecase "UC-17\nManage access\nand ethical walls" as uc17
  usecase "UC-18\nManage client keys" as uc18
  usecase "UC-19\nExamine the audit trail" as uc19
  usecase "UC-20\nDelete a closed matter" as uc20
}

rectangle "Microsoft\nEntra ID" as entra <<system>>

user -- uc16
admin -- uc17
admin -- uc18
admin -- uc19
admin -- uc20

uc16 -- entra
@enduml
