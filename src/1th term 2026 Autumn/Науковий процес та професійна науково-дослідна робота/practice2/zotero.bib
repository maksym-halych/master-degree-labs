@inproceedings{hanzlicekLeveragingZeroShotTTS2027,
  title = {Leveraging {{Zero-Shot TTS}} for~{{Data Augmentation}}: {{A Comparison}} of~{{VITS}} and~{{StyleTTS2}} in~{{Low-Resource And Low-Quality Conditions}}},
  shorttitle = {Leveraging {{Zero-Shot TTS}} for~{{Data Augmentation}}},
  booktitle = {Text, {{Speech}}, and {{Dialogue}}},
  author = {Hanzlíček, Zdeněk and Matoušek, Jindřich and Tihelka, Daniel and Lehečka, Jan},
  editor = {Nöth, Elmar and Horák, Aleš and Sojka, Petr},
  date = {2027},
  pages = {351--362},
  publisher = {Springer Nature Switzerland},
  location = {Cham},
  doi = {10.1007/978-3-032-37249-9_29},
  abstract = {The performance of many Text-to-Speech systems still depends on the quality and volume of training data. In many practical situations, the appropriate data is not available. This paper describes our experiments on using the zero-shot capabilities of the ZipVoice TTS system to create a synthetic training corpus for other TTS architectures, namely VITS and StyleTTS2. A comparative analysis revealed that 1) ZipVoice can generate cleaner speech than the default noisy prompt, and 2) both VITS and StyleTTS2 were preferred to ZipVoice in listening tests. These findings suggest that generative data augmentation is a viable approach for developing TTS systems when appropriate human data is unavailable. This paper is a case study that aims to develop a stable personal TTS system for a prominent Czech academic artist, utilizing his low-quality archival recordings.},
  isbn = {978-3-032-37249-9},
  langid = {english},
  keywords = {speech synthesis,StyleTTS2,TTS,VITS,zero-shot,ZipVoice}
}

@article{kimParalinguisticAcousticFeature2027,
  title = {Paralinguistic Acoustic Feature to Natural Language Prompt Conversion Using Hybrid Transformer–{{LLaMA}} Architecture},
  author = {Kim, Junyoung and Choi, Ahyoung},
  date = {2027-03-01},
  journaltitle = {Computer Speech \& Language},
  shortjournal = {Computer Speech \& Language},
  volume = {103},
  pages = {102044},
  issn = {0885-2308},
  doi = {10.1016/j.csl.2026.102044},
  url = {https://www.sciencedirect.com/science/article/pii/S0885230826001075},
  urldate = {2026-10-16},
  abstract = {Speaking-style captioning aims to generate natural language descriptions of paralinguistic characteristics in speech, such as pitch, speaking speed, and vocal energy. While recent approaches leverage large pre-trained speech encoders and language models, the interaction between heterogeneous speech representations and their impact on style caption generation remain insufficiently explored. In this work, we conduct an empirical study analyzing the effects of combining self-supervised and supervised speech representations within an end-to-end captioning framework. We integrate a HuBERT-based waveform encoder and a Whisper-based spectrogram encoder, whose complementary representations are fused via cross-attention and aggregated through a learnable post encoder before being decoded by a QLoRA-adapted LLaMA model. Our results on PromptTTS, DreamVoice, and TextrolSpeech demonstrate that representation types contribute unevenly across speaking-style attributes. The dual-encoder configuration achieves the strongest overall performance in most settings, and the post encoder improves the overall trend across attribute and captioning metrics, although a small CIDEr fluctuation is observed on DreamVoice. Compared with both SECap and zero-shot Qwen2-Audio baselines, our method achieves stronger caption quality and more reliable attribute-level interpretability. These results demonstrate that representation complementarity and post-aggregation play a critical role in producing semantically grounded and stylistically expressive speaking-style captions.},
  keywords = {Paralinguistic features,Speech-to-text,Style prompt generation},
  file = {/home/max/Zotero/storage/RYPQ334P/S0885230826001075.html}
}

