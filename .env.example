# Copy to .env and adjust. Every value here has a working default except the
# Drive credential and FILE_ID, which you must supply.

# The recording to process, from its Drive URL:
#   https://drive.google.com/file/d/<FILE_ID>/view
# `make run` uses this. Override for a one-off with `make run FILE_ID=<other>`.
FILE_ID=

# Path to the service account JSON key. Either rename your download to this
# path, or point this at the file Google gave you.
GOOGLE_SERVICE_ACCOUNT=.cache/service-account.json

# Self-hosted Parakeet ASR server (see docker-compose.yaml).
PARAKEET_BASE_URL=http://127.0.0.1:5092/v1
# Only needed if PARAKEET_API_KEY is set on the server.
PARAKEET_API_KEY=not-needed

# Who pays for summarization. `api` calls the Messages API and bills an Anthropic
# API organization. `claude-cli` shells out to the Claude Code executable and
# reuses its interactive login, which on a Pro/Max account means the subscription
# instead of API credits — at the cost of needing `claude` installed and logged in
# on this machine, so the pipeline no longer runs unchanged on another host or CI.
# Usage also counts against Claude Code's own limits, so a batch of lectures can
# leave you rate-limited in your interactive sessions.
SUMMARY_BACKEND=api
# Only read when SUMMARY_BACKEND=claude-cli. An absolute path if not on PATH.
CLAUDE_BIN=claude

# Only read when SUMMARY_BACKEND=api. Leave unset to let the Anthropic SDK
# resolve credentials itself (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an
# `ant auth login` profile).
# ANTHROPIC_API_KEY=
# Passed to both backends; `claude` also accepts aliases like `opus`.
ANTHROPIC_MODEL=claude-opus-5

# ISO-639-1 code passed to the ASR server; it defaults to English otherwise.
LANGUAGE=uk
SUMMARY_LANGUAGE=uk

# Chunking. Stay under ~400 s, the encoder's single-pass limit: past it the
# server splits internally and de-duplicates the seams, which loses text. The
# same 1206 s of audio yields 10.7 chars/s in one request and 15.2 in 390 s
# pieces. The search window is deliberately narrow so a chunk cannot drift over.
CHUNK_SECONDS=390
CHUNK_SEARCH_WINDOW=30

# Gitignored working tree (media, weights, credentials) and committed artifacts.
CACHE_DIR=.cache
DOCS_DIR=docs
LOGS_DIR=logs

# The lab report to render: the directory holding its main.tex. `make
# render-report` reads this and derives everything else from the path — the
# term, the subject and the report name all come from the directory names, so
# adding a subject needs no Makefile change. Override for a one-off with
# `make render-report REPORT=<other dir>`. Unquoted, spaces and all.
REPORT=src/1th term 2026 Autumn/Штучний інтелект та інноваційні інформаційні технології/lab1
